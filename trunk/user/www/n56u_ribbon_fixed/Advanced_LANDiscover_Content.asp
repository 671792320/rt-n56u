<!DOCTYPE html>
<html><head>
<title><#Web_Title#> - 局域网发现</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<link rel="shortcut icon" href="images/favicon.ico"><link rel="icon" href="images/favicon.png">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/main.css">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/engage.itoggle.css">
<script type="text/javascript" src="/jquery.js"></script>
<script type="text/javascript" src="/state.js"></script>
<script type="text/javascript" src="/popup.js"></script>
<script type="text/javascript" src="/bootstrap/js/bootstrap.min.js"></script>
<script type="text/javascript" src="/bootstrap/js/engage.itoggle.min.js"></script>
<script type="text/javascript" src="/itoggle.js"></script>
<script type="text/javascript">
var $j=jQuery.noConflict();<% login_state_hook(); %>;
var rtimer,ci=0;
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}
function section(t,name,next){var p=t.indexOf(name+'\n');if(p<0)return '';p+=name.length+1;var q=next?t.indexOf('\n'+next,p):-1;return (q<0?t.slice(p):t.slice(p,q)).replace(/\r/g,'');}
function parseData(t){var first=(t.split('\n')[0]||'').split('|');return {ifname:first[1]||'-',role:first[2]||'-',ip:first[3]||'-',mac:first[4]||'-',link:first[5]||'-',dhcp:first[6]||'-',state:first[7]||'-',count:first[8]||'0',last:first[9]||'-',interfaces:section(t,'---IFACES---','---LOG---'),log:section(t,'---LOG---','---DEVICES---'),devices:section(t,'---DEVICES---','---CUSTOM---'),custom:section(t,'---CUSTOM---',null).trim()};}
function initMainToggles(){['lan_discovery_enable','lan_discovery_dhcp_enable','lan_discovery_discover_enable','lan_discovery_onvif','lan_discovery_ssdp','lan_discovery_hik','lan_discovery_dahua','lan_discovery_raw'].forEach(function(id){init_itoggle(id);});}
function ajaxData(cb){var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState===4&&x.status===200)cb(x.responseText);};x.open('GET','Advanced_LANDiscover_Data.asp?_='+new Date().getTime(),true);x.send(null);}
function renderIfaces(s){var sel=document.getElementById('lan_ifname'),cur=sel.value||sel.getAttribute('data-value')||'',lines=String(s||'').replace(/\\n/g,'\n').split('\n');sel.innerHTML='';for(var i=0;i<lines.length;i++){if(!lines[i])continue;var f=lines[i].split('|');if(f.length<5)continue;var o=document.createElement('option');o.value=f[0];o.text=f[0]+' | '+f[1]+' | '+f[2]+' | '+f[4];if(f[0]===cur)o.selected=true;sel.appendChild(o);}if(!sel.value&&sel.options.length)sel.selectedIndex=0;}
function renderDevices(s){var body=document.getElementById('devices');body.innerHTML='';var lines=String(s||'').replace(/\\n/g,'\n').split('\n');for(var i=0;i<lines.length;i++){var l=lines[i].trim();if(!l||l.indexOf('DEVICE ')!==0)continue;var typ=(l.match(/type=([^ ]+)/)||[])[1]||'-';var ip=(l.match(/IP=([^ ]+)/)||[])[1]||'-';var mac=(l.match(/MAC=([^ ]+)/)||[])[1]||'-';var info=(l.match(/INFO=(.*)$/)||[])[1]||'-';var tr=document.createElement('tr');tr.innerHTML='<td>-</td><td>'+esc(typ)+'</td><td>'+esc(ip)+'</td><td>'+esc(mac)+'</td><td>'+esc(info)+'</td>';body.appendChild(tr);}if(!body.children.length)body.innerHTML='<tr><td colspan="5">暂无设备</td></tr>';}
function renderCustom(s){var box=document.getElementById('custom_list');box.innerHTML='';ci=0;var rows=String(s||'').replace(/\\n/g,'\n').split('\n');for(var i=0;i<rows.length;i++){if(!rows[i])continue;var f=rows[i].split('|');if(f.length<5)continue;addCustomRow(decodeURIComponent(f[0]||''),decodeURIComponent(f[1]||''),decodeURIComponent(f[2]||''),decodeURIComponent(f[3]||''),f[4]);}}
function addCustomRow(n,a,p,y,e){var id='lan_custom_'+(ci++),row=document.createElement('div'),on=e==='1';row.className='well well-small custom-row';row.setAttribute('data-id',id);row.innerHTML='<div class="row-fluid"><div class="span2"><input class="span12 c-name" value="'+esc(n||'')+'" placeholder="名称"></div><div class="span3"><input class="span12 c-addr" value="'+esc(a||'')+'" placeholder="目标地址/组播地址"></div><div class="span1"><input class="span12 c-port" value="'+esc(p||'')+'" placeholder="UDP端口"></div><div class="span3"><input class="span12 c-payload" value="'+esc(y||'')+'" placeholder="Payload"></div><div class="span2"><div id="'+id+'_on_of"><input type="checkbox" id="'+id+'_fake" value="1" '+(on?'checked':'')+'><label class="itoggle" for="'+id+'_fake"></label></div><input type="radio" name="'+id+'" id="'+id+'_0" value="0" style="display:none" '+(on?'':'checked')+'><input type="radio" name="'+id+'" id="'+id+'_1" value="1" style="display:none" '+(on?'checked':'')+'><input class="c-enable" type="hidden" value="'+(on?'1':'0')+'"></div><div class="span1"><button type="button" class="btn btn-danger btn-mini" onclick="this.parentNode.parentNode.parentNode.remove()">−</button></div></div>';document.getElementById('custom_list').appendChild(row);init_itoggle(id,function(){row.querySelector('.c-enable').value=$j('#'+id+'_fake').val()==='1'?'1':'0';});}
function addCustom(){addCustomRow('','','','', '1');}
function serializeCustom(){var rows=document.getElementById('custom_list').children,out=[];for(var i=0;i<rows.length;i++){var r=rows[i];out.push(encodeURIComponent(r.querySelector('.c-name').value)+'|'+encodeURIComponent(r.querySelector('.c-addr').value)+'|'+encodeURIComponent(r.querySelector('.c-port').value)+'|'+encodeURIComponent(r.querySelector('.c-payload').value)+'|'+r.querySelector('.c-enable').value);}document.getElementById('lan_discovery_custom').value=out.join('\n');}
function refresh(){ajaxData(function(t){var o=parseData(t);renderIfaces(o.interfaces);document.getElementById('status_iface').innerHTML=esc(o.ifname)+' ('+esc(o.role)+')';document.getElementById('status_ip').innerHTML=esc(o.ip||'-');document.getElementById('status_mac').innerHTML=esc(o.mac||'-');document.getElementById('status_link').innerHTML=esc(o.link||'-');document.getElementById('status_dhcp').innerHTML=esc(o.dhcp||'-');document.getElementById('status_state').innerHTML=esc(o.state||'-');document.getElementById('status_count').innerHTML=esc(o.count||'0');document.getElementById('status_last').innerHTML=esc(o.last||'-');var lg=document.getElementById('live_log');lg.textContent=o.log||'暂无日志';lg.scrollTop=lg.scrollHeight;renderDevices(o.devices);if(!document.getElementById('custom_list').children.length&&o.custom)renderCustom(o.custom);});}
function clearLog(){if(!login_safe())return false;document.getElementById('lan_discovery_log').value='';return save();}
function save(){if(!login_safe())return false;serializeCustom();document.form.action_mode.value=' Apply ';document.form.current_page.value='/Advanced_LANDiscover_Content.asp';document.form.next_page.value='/Advanced_LANDiscover_Content.asp';document.form.submit();return false;}
function initial(){show_banner(1);show_menu(8,0,0);show_footer();initMainToggles();refresh();rtimer=setInterval(refresh,1000);}
</script></head>
<body onLoad="initial();"><div class="wrapper"><div class="container-fluid"><div class="row-fluid"><div class="span3"><center><div id="logo"></div></center></div><div class="span9"><div id="TopBanner"></div></div></div></div><div id="Loading" class="popup_bg"></div><iframe name="hidden_frame" id="hidden_frame" src="" width="0" height="0" frameborder="0"></iframe>
<form method="post" name="form" action="apply.cgi"><input type="hidden" name="current_page"><input type="hidden" name="next_page"><input type="hidden" name="action_mode"><input type="hidden" name="action_script"><input type="hidden" name="lan_discovery_custom" id="lan_discovery_custom" value="<% nvram_get_x("", "lan_discovery_custom"); %>"><input type="hidden" name="lan_discovery_log" id="lan_discovery_log" value="">
<div class="container-fluid"><div class="row-fluid"><div class="span3"><div class="well sidebar-nav side_nav" style="padding:0"><ul id="mainMenu" class="clearfix"></ul><ul><li><div id="subMenu" class="accordion"></div></li></ul></div></div><div class="span9"><div class="box well grad_colour_dark_blue"><h2 class="box_head round_top">局域网自动发现</h2><div class="round_bottom"><div id="tabMenu" class="submenuBlock"></div>
<div class="alert alert-info">LAN事件 → DHCP检测 → 设备发现。自身地址自动过滤。</div>
<table class="table table-condensed"><tr><th colspan="4">当前状态</th></tr><tr><td>检测接口</td><td id="status_iface">-</td><td>IPv4</td><td id="status_ip">-</td></tr><tr><td>MAC</td><td id="status_mac">-</td><td>Link</td><td id="status_link">-</td></tr><tr><td>DHCP</td><td id="status_dhcp">-</td><td>发现状态</td><td id="status_state">-</td></tr><tr><td>已发现</td><td id="status_count">0</td><td>最后活动</td><td id="status_last">-</td></tr></table>
<table class="table"><tr><th style="width:180px">检测接口</th><td><select name="lan_discovery_ifname" id="lan_ifname" class="span9" data-value="<% nvram_get_x("", "lan_discovery_ifname"); %>"></select></td></tr>
<tr><td>LAN事件检测</td><td><div id="lan_discovery_enable_on_of"><input type="checkbox" id="lan_discovery_enable_fake" value="1" <% nvram_match_x("", "lan_discovery_enable", "1", "checked"); %>><label class="itoggle" for="lan_discovery_enable_fake"></label></div><input type="radio" name="lan_discovery_enable" id="lan_discovery_enable_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_enable", "0", "checked"); %>><input type="radio" name="lan_discovery_enable" id="lan_discovery_enable_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_enable", "1", "checked"); %>></td></tr>
<tr><td>DHCP检测</td><td><div id="lan_discovery_dhcp_enable_on_of"><input type="checkbox" id="lan_discovery_dhcp_enable_fake" value="1" <% nvram_match_x("", "lan_discovery_dhcp_enable", "1", "checked"); %>><label class="itoggle" for="lan_discovery_dhcp_enable_fake"></label></div><input type="radio" name="lan_discovery_dhcp_enable" id="lan_discovery_dhcp_enable_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_dhcp_enable", "0", "checked"); %>><input type="radio" name="lan_discovery_dhcp_enable" id="lan_discovery_dhcp_enable_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_dhcp_enable", "1", "checked"); %>> 超时 <input name="lan_discovery_dhcp_timeout" class="span2" value="<% nvram_get_x("", "lan_discovery_dhcp_timeout"); %>"></td></tr>
<tr><td>设备发现</td><td><div id="lan_discovery_discover_enable_on_of"><input type="checkbox" id="lan_discovery_discover_enable_fake" value="1" <% nvram_match_x("", "lan_discovery_discover_enable", "1", "checked"); %>><label class="itoggle" for="lan_discovery_discover_enable_fake"></label></div><input type="radio" name="lan_discovery_discover_enable" id="lan_discovery_discover_enable_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_discover_enable", "0", "checked"); %>><input type="radio" name="lan_discovery_discover_enable" id="lan_discovery_discover_enable_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_discover_enable", "1", "checked"); %>> 超时 <input name="lan_discovery_timeout" class="span2" value="<% nvram_get_x("", "lan_discovery_timeout"); %>"></td></tr>
<tr><td>ONVIF</td><td><div id="lan_discovery_onvif_on_of"><input type="checkbox" id="lan_discovery_onvif_fake" value="1" <% nvram_match_x("", "lan_discovery_onvif", "1", "checked"); %>><label class="itoggle" for="lan_discovery_onvif_fake"></label></div><input type="radio" name="lan_discovery_onvif" id="lan_discovery_onvif_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_onvif", "0", "checked"); %>><input type="radio" name="lan_discovery_onvif" id="lan_discovery_onvif_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_onvif", "1", "checked"); %>> 端口 <input name="lan_discovery_onvif_port" class="span2" value="<% nvram_get_x("", "lan_discovery_onvif_port"); %>"></td></tr>
<tr><td>SSDP</td><td><div id="lan_discovery_ssdp_on_of"><input type="checkbox" id="lan_discovery_ssdp_fake" value="1" <% nvram_match_x("", "lan_discovery_ssdp", "1", "checked"); %>><label class="itoggle" for="lan_discovery_ssdp_fake"></label></div><input type="radio" name="lan_discovery_ssdp" id="lan_discovery_ssdp_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_ssdp", "0", "checked"); %>><input type="radio" name="lan_discovery_ssdp" id="lan_discovery_ssdp_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_ssdp", "1", "checked"); %>> 端口 <input name="lan_discovery_ssdp_port" class="span2" value="<% nvram_get_x("", "lan_discovery_ssdp_port"); %>"></td></tr>
<tr><td>HIK-SADP</td><td><div id="lan_discovery_hik_on_of"><input type="checkbox" id="lan_discovery_hik_fake" value="1" <% nvram_match_x("", "lan_discovery_hik", "1", "checked"); %>><label class="itoggle" for="lan_discovery_hik_fake"></label></div><input type="radio" name="lan_discovery_hik" id="lan_discovery_hik_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_hik", "0", "checked"); %>><input type="radio" name="lan_discovery_hik" id="lan_discovery_hik_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_hik", "1", "checked"); %>> 端口 <input name="lan_discovery_hik_port" class="span2" value="<% nvram_get_x("", "lan_discovery_hik_port"); %>"></td></tr>
<tr><td>DAHUA-DHIP</td><td><div id="lan_discovery_dahua_on_of"><input type="checkbox" id="lan_discovery_dahua_fake" value="1" <% nvram_match_x("", "lan_discovery_dahua", "1", "checked"); %>><label class="itoggle" for="lan_discovery_dahua_fake"></label></div><input type="radio" name="lan_discovery_dahua" id="lan_discovery_dahua_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_dahua", "0", "checked"); %>><input type="radio" name="lan_discovery_dahua" id="lan_discovery_dahua_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_dahua", "1", "checked"); %>> 端口 <input name="lan_discovery_dahua_port" class="span2" value="<% nvram_get_x("", "lan_discovery_dahua_port"); %>"></td></tr>
<tr><td>ARP/IP</td><td><div id="lan_discovery_raw_on_of"><input type="checkbox" id="lan_discovery_raw_fake" value="1" <% nvram_match_x("", "lan_discovery_raw", "1", "checked"); %>><label class="itoggle" for="lan_discovery_raw_fake"></label></div><input type="radio" name="lan_discovery_raw" id="lan_discovery_raw_0" value="0" style="display:none" <% nvram_match_x("", "lan_discovery_raw", "0", "checked"); %>><input type="radio" name="lan_discovery_raw" id="lan_discovery_raw_1" value="1" style="display:none" <% nvram_match_x("", "lan_discovery_raw", "1", "checked"); %>></td></tr></table>
<div class="box"><h4>已发现设备</h4><table class="table table-striped"><thead><tr><th>时间</th><th>协议</th><th>IP</th><th>MAC</th><th>信息</th></tr></thead><tbody id="devices"><tr><td colspan="5">暂无设备</td></tr></tbody></table></div>
<div class="box"><h4>实时发现日志 <button type="button" class="btn btn-mini pull-right" onclick="clearLog()">清空</button></h4><pre id="live_log" style="height:220px;overflow:auto;margin:0">加载中...</pre></div>
<div class="box"><h4>自定义 UDP 发现协议 <button type="button" class="btn btn-success btn-mini pull-right" onclick="addCustom()">＋ 添加</button></h4><div class="muted">名称 / 目标地址 / UDP端口 / Payload / 开关 / 删除，不限制 6 条。</div><div id="custom_list"></div><div style="margin-top:10px"><button type="button" class="btn btn-primary" onclick="save()">保存设置</button></div></div>
</div></div></div></div></div></div></form><div id="footer"></div></div></body></html>
