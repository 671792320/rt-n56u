<!DOCTYPE html>
<html>
<head>
<title><#Web_Title#> - LAN监听与设备发现</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="Pragma" content="no-cache"><meta http-equiv="Expires" content="-1">
<link rel="shortcut icon" href="images/favicon.ico"><link rel="icon" href="images/favicon.png">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/main.css">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/engage.itoggle.css">
<script src="/jquery.js"></script><script src="/bootstrap/js/bootstrap.min.js"></script>
<script src="/bootstrap/js/engage.itoggle.min.js"></script><script src="/state.js"></script>
<script src="/general.js"></script><script src="/itoggle.js"></script><script src="/popup.js"></script>
<script src="/help.js"></script><script src="/login_state_hook.js"></script>
<script>
var $j=jQuery.noConflict(),refresh_timer=null,device_history={},device_page=1,matrix_net='';
$j(document).ready(function(){init_itoggle('lan_discovery_enable');init_itoggle('lan_discovery_dhcp_enable');init_itoggle('lan_discovery_discover_enable');});
function val(v,d){return v!==undefined&&v!==null&&String(v)!==''&&String(v)!=='-'?String(v):d;}
function lines(s){return String(s||'').replace(/\r/g,'').split(/\n|\u2028/).map(function(x){return x.replace(/^\s+|\s+$/g,'');}).filter(function(x){return x;});}
function decode(s){var v=String(s||'');for(var i=0;i<4;i++)v=v.replace(/&amp;/g,'&').replace(/&#10;/g,'\n').replace(/&#13;/g,'\n');return v;}
function mac(s){s=String(s||'').replace(/\\/g,'').replace(/\s/g,'').toUpperCase();return /^([0-9A-F]{2}:){5}[0-9A-F]{2}$/.test(s)?s:'-';}
function ipkey(ip){var p=String(ip||'').split('.');if(p.length!==4)return 0x7fffffff;return (((+p[0])*256+(+p[1]))*256+(+p[2]))*256+(+p[3]);}
function status_cls(s){return s==='在线'?'ok':(s==='IP冲突'?'bad':(s==='暂时离线'?'off':'warn'));}
function parse(data){data=decode(data);var f=(data.split('\n')[0]||'').split('|');function sec(a,b){var p=data.indexOf(a);if(p<0)return '';p+=a.length;var q=b?data.indexOf(b,p):-1;return data.substring(p,q<0?data.length:q);}return {iface:val(f[1],'-'),role:val(f[2],'-'),ip:val(f[3],'-'),mac:mac(val(f[4],'-')),link:val(f[5],'-'),dhcp:val(f[6],'未检测'),state:val(f[7],'空闲'),count:val(f[8],'0'),last:val(f[9],'-'),health:val(f[10],'未监视'),interfaces:sec('---IFACES---','---LOG---'),log:sec('---LOG---','---DEVICES---'),devices:sec('---DEVICES---','---TARGETS---'),targets:sec('---TARGETS---','---CUSTOM---'),custom:sec('---CUSTOM---','')};}
function render_status(o){$j('#st_if').text(o.iface);$j('#st_ip').text(o.ip);$j('#st_mac').text(o.mac);$j('#st_link').text(o.link==='UP'?'已插入':(o.link==='DOWN'?'未插入':o.link));$j('#st_dhcp').text(o.dhcp);$j('#st_state').text(o.state);$j('#st_count').text(o.count);$j('#st_last').text(o.last);$j('#st_health').text(o.health);}
function render_ifaces(s){var sel=document.getElementById('lan_ifname');if(!sel)return;var wanted='<% nvram_get_x("", "lan_discovery_ifname"); %>';var a=lines(s),ok=false;sel.innerHTML='';for(var i=0;i<a.length;i++){var p=a[i].split('|');if(p.length<5||p[1]!=='LAN'||/^(lo|br|ra|wds|apcli)/.test(p[0]))continue;var o=document.createElement('option');o.value=p[0];o.text=p[0]+' | LAN | '+(p[2]||'-')+' | '+(p[4]||'-');if(p[0]===wanted){o.selected=true;ok=true;}sel.appendChild(o);}if(!sel.options.length){var o=document.createElement('option');o.value=wanted||'eth2.1';o.text=o.value+' | LAN';o.selected=true;sel.appendChild(o);}else if(!ok)sel.selectedIndex=0;}
function device_rows(s){var a=lines(s),m={},rows=[],arp={};for(var i=0;i<a.length;i++){if(a[i].indexOf('DEVICE ')!==0)continue;var t=(a[i].match(/type=([^ ]+)/)||[])[1]||'-',ip=(a[i].match(/IP=([^ ]+)/)||[])[1]||'-',mc=mac((a[i].match(/MAC=([^ ]+)/)||[])[1]||'-'),info=(a[i].match(/INFO=(.*)$/)||[])[1]||'-';if(t==='SUBNET')continue;if(!m[ip])m[ip]={ip:ip,mac:mc,info:info,pro:[],status:'在线',ping:(a[i].match(/PING=([^ ]+)/)||[])[1]||'-',miss:0,conf:0};var r=m[ip];if(mc!=='-'&&r.mac==='-')r.mac=mc;if(info!=='-'&&r.info==='-')r.info=info;if(t==='IP_CONFLICT'){r.conf=1;r.status='IP冲突';}else if(t!=='ARP'&&t!=='IP_CONFLICT'&&t!=='PROTO_FAIL'&&r.pro.indexOf(t)<0)r.pro.push(t);if(t==='ARP')arp[ip]=1;}
for(var k in m){var h=device_history[k]||{miss:0,mac:m[k].mac};if(m[k].mac==='-'&&h.mac!=='-')m[k].mac=h.mac;if(arp[k])h.miss=0;else h.miss=(h.miss||0)+1;device_history[k]=h;m[k].miss=h.miss;if(!arp[k]&&h.miss>=3&&m[k].status!=='IP冲突')m[k].status='暂时离线';rows.push(m[k]);}
rows.sort(function(a,b){return ipkey(a.ip)-ipkey(b.ip);});return rows;}
function render_devices(s){var rows=device_rows(s),body=document.getElementById('devices');$j('#device_count').text(rows.length);var start=(device_page-1)*8,end=Math.min(start+8,rows.length),h='';for(var i=start;i<end;i++){var r=rows[i],info=decode(r.info);h+='<tr class="'+status_cls(r.status)+'"><td>'+r.status+'</td><td>'+((r.pro.length?r.pro.join(' / '):'ARP'))+'</td><td>'+r.ip+'</td><td>'+r.mac+'</td><td>'+r.ping+'</td><td>'+info+'</td></tr>';}body.innerHTML=h||'<tr><td colspan="6" class="muted">暂无设备</td></tr>';$j('#pager').text(rows.length?('第 '+device_page+' / '+Math.max(1,Math.ceil(rows.length/8))+' 页，共 '+rows.length+' 条'):'');}
function render_targets(s){var a=lines(s),h='';for(var i=0;i<a.length;i++){var p=a[i].split('|');if(p.length<2)continue;h+='<tr><td>'+p[0]+'</td><td>'+p[1]+'</td><td><span class="oktxt">SNAT已启用</span></td></tr>';}document.getElementById('targets').innerHTML=h||'<tr><td colspan="3" class="muted">当前没有活动目标网段</td></tr>';}
function render_log(s){document.getElementById('live_log').textContent=lines(s).join('\n')||'暂无日志';}
function render_matrix(rows){var box=document.getElementById('matrix'),nets={};for(var i=0;i<rows.length;i++){var p=rows[i].ip.split('.');if(p.length===4)nets[p[0]+'.'+p[1]+'.'+p[2]+'.0']=1;}var names=[];for(var n in nets)names.push(n);names.sort(function(a,b){return ipkey(a)-ipkey(b);});if(!names.length){box.innerHTML='<div class="muted">等待设备网段</div>';return;}if(!matrix_net||!nets[matrix_net])matrix_net=names[0];var pre=matrix_net.split('.'),h='<div class="net-tabs">';for(i=0;i<names.length;i++)h+='<button type="button" class="btn btn-small '+(names[i]===matrix_net?'active':'')+'" data-net="'+names[i]+'">'+names[i]+'/24</button>';h+='</div><div class="ipgrid">';var by={};for(i=0;i<rows.length;i++)by[rows[i].ip]=rows[i];for(i=1;i<255;i++){var ip=pre[0]+'.'+pre[1]+'.'+pre[2]+'.'+i,r=by[ip],cl=r?(r.status==='IP冲突'?'c':(r.ip==='<% nvram_get_x("", "lan_ipaddr"); %>'?'s':'u')):'f';h+='<span class="cell '+cl+'" title="'+ip+'">'+i+'</span>';}h+='</div>';box.innerHTML=h;$('.net-tabs button').click(function(){matrix_net=$(this).data('net');refresh_data();});}
function refresh_data(){var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState!==4||x.status!==200)return;var o=parse(x.responseText);render_status(o);render_ifaces(o.interfaces);var rows=device_rows(o.devices);render_devices(o.devices);render_targets(o.targets);render_log(o.log);render_matrix(rows);};x.open('GET','Advanced_LANDiscover_Data.asp?_='+new Date().getTime(),true);x.send();}
function applyRule(){showLoading();document.form.action_mode.value='Restart';document.form.submit();return false;}
function initial(){show_banner(1);show_menu(5,3,1);show_footer();refresh_data();refresh_timer=setInterval(refresh_data,2000);}
</script>
<style>
.oktxt{color:#3c763d;font-weight:bold}.ok{background:#eaf7ea}.bad{background:#f6dede}.off{background:#f7f0d8}.warn{background:#fff5dd}.live{height:210px;overflow:auto;background:#111;color:#ddd;padding:8px;font:12px monospace;white-space:pre-wrap}.net-tabs{margin:8px 0}.net-tabs .btn{margin-right:4px}.ipgrid{display:grid;grid-template-columns:repeat(16,1fr);gap:3px;padding:8px;background:#f7f7f7;border:1px solid #ddd}.cell{display:block;text-align:center;padding:4px 0;border:1px solid #bbb;border-radius:3px}.cell.f{background:#eee;color:#999}.cell.u{background:#8fd19e}.cell.s{background:#70c4df}.cell.c{background:#e68181;color:#fff}.muted{color:#999}
</style>
</head>
<body onload="initial();">
<div class="wrapper"><div class="container-fluid"><div class="row-fluid"><div class="span3"><center><div id="logo"></div></center></div><div class="span9"><div id="TopBanner"></div></div></div></div><div id="Loading" class="popup_bg"></div><form method="post" name="form" action="/start_apply.htm"><input type="hidden" name="current_page" value="Advanced_LANDiscover_Content.asp"><input type="hidden" name="next_page" value="Advanced_LANDiscover_Content.asp"><input type="hidden" name="action_mode" value="Restart"><div class="container-fluid"><div class="row-fluid"><div class="span3"><div class="well sidebar-nav side_nav" style="padding:0"><ul id="mainMenu" class="clearfix"></ul><ul class="clearfix"><li><div id="subMenu" class="accordion"></div></li></ul></div></div><div class="span9"><div class="box well grad_colour_dark_blue"><h2 class="box_head round_top">LAN监听与设备发现</h2><div class="round_bottom"><div id="tabMenu" class="submenuBlock"></div><div class="alert alert-info">LAN口插拔、DHCP探测、设备发现、目标网段接管和SNAT均由后端持续运行；本页用于配置和查看实时状态。</div><table class="table table-bordered"><tr><th>检测接口</th><td><select id="lan_ifname" name="lan_discovery_ifname"><option value="eth2.1">eth2.1 | LAN</option></select></td></tr><tr><th>LAN监听</th><td><input type="checkbox" name="lan_discovery_enable" value="1" <% nvram_match_x("", "lan_discovery_enable", "1", "checked"); %>></td></tr><tr><th>DHCP检测</th><td><input type="checkbox" name="lan_discovery_dhcp_enable" value="1" <% nvram_match_x("", "lan_discovery_dhcp_enable", "1", "checked"); %>></td></tr><tr><th>设备发现</th><td><input type="checkbox" name="lan_discovery_discover_enable" value="1" <% nvram_match_x("", "lan_discovery_discover_enable", "1", "checked"); %>></td></tr><tr><th>DHCP等待时间</th><td><input class="mini" name="lan_discovery_dhcp_timeout" value="<% nvram_get_x("", "lan_discovery_dhcp_timeout"); %>"> 秒</td></tr><tr><th>设备发现周期</th><td><input class="mini" name="lan_discovery_cycle" value="<% nvram_get_x("", "lan_discovery_cycle"); %>"> 秒</td></tr><tr><th>响应等待时间</th><td><input class="mini" name="lan_discovery_probe_timeout" value="<% nvram_get_x("", "lan_discovery_probe_timeout"); %>"> 秒</td></tr><tr><th>目标丢失轮数</th><td><input class="mini" name="lan_discovery_miss_limit" value="<% nvram_get_x("", "lan_discovery_miss_limit"); %>"> 轮</td></tr></table><table class="table table-condensed"><tr><th>接口</th><td id="st_if">-</td><th>IP</th><td id="st_ip">-</td><th>MAC</th><td id="st_mac">-</td></tr><tr><th>网线</th><td id="st_link">-</td><th>DHCP</th><td id="st_dhcp">-</td><th>状态</th><td id="st_state">-</td></tr><tr><th>设备数</th><td id="st_count">0</td><th>最后活动</th><td id="st_last">-</td><th>健康</th><td id="st_health">-</td></tr></table><h4>目标网段与临时IP</h4><table class="table table-bordered table-condensed"><thead><tr><th>目标网段</th><th>临时IP</th><th>状态</th></tr></thead><tbody id="targets"><tr><td colspan="3" class="muted">等待状态...</td></tr></tbody></table><h4>IP占用情况</h4><div id="matrix"><div class="muted">等待发现...</div></div><h4>已发现设备</h4><table class="table table-bordered table-condensed"><thead><tr><th>状态</th><th>协议</th><th>IP</th><th>MAC</th><th>Ping</th><th>信息</th></tr></thead><tbody id="devices"><tr><td colspan="6" class="muted">暂无设备</td></tr></tbody></table><div id="pager" class="muted" style="text-align:right"></div><h4>实时日志</h4><pre id="live_log" class="live">暂无日志</pre><div style="text-align:center;margin-top:12px"><input class="btn btn-primary" type="button" value="保存" onclick="applyRule();return false;"></div></div></div></div></div></div></form><div id="footer"></div></div>
</body></html>
