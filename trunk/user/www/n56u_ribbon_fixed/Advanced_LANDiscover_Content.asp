<!DOCTYPE html>
<html><head>
<title><#Web_Title#> - 局域网发现</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<link rel="shortcut icon" href="images/favicon.ico"><link rel="icon" href="images/favicon.png">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="/bootstrap/css/main.css">
<script type="text/javascript" src="/jquery.js"></script><script type="text/javascript" src="/state.js"></script><script type="text/javascript" src="/popup.js"></script>
<script type="text/javascript">
var $j=jQuery.noConflict();<% login_state_hook(); %>;
var st,lg,dv,ci=0;
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}
function ajax(u,cb){var x=new XMLHttpRequest();x.onreadystatechange=function(){if(x.readyState===4&&x.status===200)cb(x.responseText);};x.open('GET',u+(u.indexOf('?')>=0?'&':'?')+'_='+new Date().getTime(),true);x.send(null);}
function initial(){show_banner(1);show_menu(8,0,0);show_footer();load_ifaces();load_status();load_log();load_devices();load_custom();st=setInterval(load_status,2000);lg=setInterval(load_log,1000);dv=setInterval(load_devices,2000);}
function load_ifaces(){ajax('/lan_discovery_interfaces.cgi?',function(t){var a;try{a=JSON.parse(t);}catch(e){return;}var s=document.getElementById('lan_ifname'),v=s.getAttribute('data-value')||'';s.innerHTML='';for(var i=0;i<a.length;i++){var o=document.createElement('option');o.value=a[i].ifname;o.text=a[i].ifname+' | '+a[i].role+' | '+(a[i].ip||'-')+' | '+(a[i].link||'DOWN');if(o.value===v)o.selected=true;s.appendChild(o);}});}
function load_status(){ajax('/lan_discovery_status.cgi?',function(t){var o;try{o=JSON.parse(t);}catch(e){return;}document.getElementById('status_iface').innerHTML=esc(o.ifname)+' ('+esc(o.role)+')';document.getElementById('status_ip').innerHTML=esc(o.ip||'-');document.getElementById('status_mac').innerHTML=esc(o.mac||'-');document.getElementById('status_link').innerHTML=esc(o.link||'-');document.getElementById('status_dhcp').innerHTML=esc(o.dhcp||'未检测');document.getElementById('status_state').innerHTML=esc(o.state||'空闲');document.getElementById('status_count').innerHTML=esc(o.count||'0');document.getElementById('status_last').innerHTML=esc(o.last||'-');});}
function load_log(){ajax('/lan_discovery_log.cgi?',function(t){var e=document.getElementById('live_log');e.textContent=t||'暂无日志';e.scrollTop=e.scrollHeight;});}
function load_devices(){ajax('/lan_discovery_devices.cgi?',function(t){document.getElementById('devices').innerHTML=t||'<tr><td colspan="5">暂无设备</td></tr>';});}
function clear_log(){ajax('/lan_discovery_log.cgi?clear=1',load_log);}
function sw(b){var h=b.nextElementSibling,on=h.value==='1';h.value=on?'0':'1';b.innerHTML=on?'禁用':'启用';b.className=on?'btn btn-default btn-mini':'btn btn-success btn-mini';}
function addCustom(n,a,p,y,e){var i=ci++,d=document.createElement('div');d.className='well well-small';d.innerHTML='<div class="row-fluid"><div class="span2"><input class="span12" name="lan_custom_name_'+i+'" value="'+esc(n||'')+'" placeholder="名称"></div><div class="span3"><input class="span12" name="lan_custom_addr_'+i+'" value="'+esc(a||'')+'" placeholder="目标地址/组播地址"></div><div class="span1"><input class="span12" name="lan_custom_port_'+i+'" value="'+esc(p||'')+'" placeholder="UDP端口"></div><div class="span4"><input class="span12" name="lan_custom_payload_'+i+'" value="'+esc(y||'')+'" placeholder="Payload"></div><div class="span1"><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_custom_enable_'+i+'" value="'+((e||'1')==='1'?'1':'0')+'"></div><div class="span1"><button type="button" class="btn btn-danger btn-mini" onclick="this.parentNode.parentNode.parentNode.remove()">−</button></div></div>';document.getElementById('custom_list').appendChild(d);}
function load_custom(){ajax('/lan_discovery_custom.cgi?',function(t){var a;try{a=JSON.parse(t);}catch(e){a=[];}document.getElementById('custom_list').innerHTML='';ci=0;for(var i=0;i<a.length;i++)addCustom(a[i].name,a[i].addr,a[i].port,a[i].payload,a[i].enable);});}
function save(){if(!login_safe())return false;document.form.action_mode.value=' Apply ';document.form.current_page.value='Advanced_LANDiscover_Content.asp';document.form.next_page.value='Advanced_LANDiscover_Content.asp';document.form.submit();}
</script></head>
<body onLoad="initial();"><div class="wrapper"><div class="container-fluid"><div class="row-fluid"><div class="span3"><center><div id="logo"></div></center></div><div class="span9"><div id="TopBanner"></div></div></div></div><div id="Loading" class="popup_bg"></div><iframe name="hidden_frame" id="hidden_frame" src="" width="0" height="0" frameborder="0"></iframe>
<form method="post" name="form" action="apply.cgi"><input type="hidden" name="current_page"><input type="hidden" name="next_page"><input type="hidden" name="action_mode"><input type="hidden" name="action_script">
<div class="container-fluid"><div class="row-fluid"><div class="span3"><div class="well sidebar-nav side_nav" style="padding:0"><ul id="mainMenu" class="clearfix"></ul><ul><li><div id="subMenu" class="accordion"></div></li></ul></div></div><div class="span9"><div class="box well grad_colour_dark_blue"><h2 class="box_head round_top">局域网自动发现</h2><div class="round_bottom"><div id="tabMenu" class="submenuBlock"></div>
<div class="alert alert-info">LAN事件 → DHCP检测 → 设备发现。自身地址自动过滤。</div>
<table class="table table-condensed"><tr><th colspan="4">当前状态</th></tr><tr><td>检测接口</td><td id="status_iface">-</td><td>IPv4</td><td id="status_ip">-</td></tr><tr><td>MAC</td><td id="status_mac">-</td><td>Link</td><td id="status_link">-</td></tr><tr><td>DHCP</td><td id="status_dhcp">-</td><td>发现状态</td><td id="status_state">-</td></tr><tr><td>已发现</td><td id="status_count">0</td><td>最后活动</td><td id="status_last">-</td></tr></table>
<table class="table"><tr><th style="width:180px">检测接口</th><td><select name="lan_discovery_ifname" id="lan_ifname" class="span9" data-value="<% nvram_get_x("", "lan_discovery_ifname"); %>"><option>加载中...</option></select></td></tr>
<tr><td>LAN事件检测</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_enable" value="<% nvram_get_x("", "lan_discovery_enable"); %>"></td></tr>
<tr><td>DHCP检测</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_dhcp_enable" value="<% nvram_get_x("", "lan_discovery_dhcp_enable"); %>"> 超时 <input name="lan_discovery_dhcp_timeout" class="span2" value="<% nvram_get_x("", "lan_discovery_dhcp_timeout"); %>"></td></tr>
<tr><td>设备发现</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_discover_enable" value="<% nvram_get_x("", "lan_discovery_discover_enable"); %>"> 超时 <input name="lan_discovery_timeout" class="span2" value="<% nvram_get_x("", "lan_discovery_timeout"); %>"></td></tr>
<tr><td>ONVIF</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_onvif" value="<% nvram_get_x("", "lan_discovery_onvif"); %>"> 端口 <input name="lan_discovery_onvif_port" class="span2" value="<% nvram_get_x("", "lan_discovery_onvif_port"); %>"></td></tr>
<tr><td>SSDP</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_ssdp" value="<% nvram_get_x("", "lan_discovery_ssdp"); %>"> 端口 <input name="lan_discovery_ssdp_port" class="span2" value="<% nvram_get_x("", "lan_discovery_ssdp_port"); %>"></td></tr>
<tr><td>HIK-SADP</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_hik" value="<% nvram_get_x("", "lan_discovery_hik"); %>"> 端口 <input name="lan_discovery_hik_port" class="span2" value="<% nvram_get_x("", "lan_discovery_hik_port"); %>"></td></tr>
<tr><td>DAHUA-DHIP</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_dahua" value="<% nvram_get_x("", "lan_discovery_dahua"); %>"> 端口 <input name="lan_discovery_dahua_port" class="span2" value="<% nvram_get_x("", "lan_discovery_dahua_port"); %>"></td></tr>
<tr><td>ARP/IP</td><td><button type="button" class="btn btn-success btn-mini" onclick="sw(this)">启用</button><input type="hidden" name="lan_discovery_raw" value="<% nvram_get_x("", "lan_discovery_raw"); %>"></td></tr></table>
<div class="box"><h4>已发现设备</h4><table class="table table-striped"><thead><tr><th>时间</th><th>协议</th><th>IP</th><th>MAC</th><th>信息</th></tr></thead><tbody id="devices"><tr><td colspan="5">暂无设备</td></tr></tbody></table></div>
<div class="box"><h4>实时发现日志 <button type="button" class="btn btn-mini pull-right" onclick="clear_log()">清空</button></h4><pre id="live_log" style="height:220px;overflow:auto;margin:0">加载中...</pre></div>
<div class="box"><h4>自定义 UDP 发现协议 <button type="button" class="btn btn-success btn-mini pull-right" onclick="addCustom()">＋ 添加</button></h4><div class="muted">名称 / 目标地址 / UDP端口 / Payload / 开关 / 删除，不限制 6 条。</div><div id="custom_list"></div>
<div style="margin-top:10px"><button type="button" class="btn btn-primary" onclick="save()">保存设置</button></div>
</div></div></div></div></div></div></form><div id="footer"></div></div></body></html>
