#!/bin/bash

# Clear build artifacts between CI builds
rm -rf romfs
rm -rf images
rm -rf stage
rm -rf merge
rm -f .config
rm -f config.arch

# Restore kernel config to original state
if [ -f linux-3.4.x/.config ] && [ -f configs/boards/busybox.config ]; then
    # Restore kernel .config from the board template (if .config is a symlink, it was already removed)
    rm -f linux-3.4.x/.config
fi

# Restore busybox config
rm -f user/busybox/busybox-1.24.x/.config

# Restore board header and makefile
rm -f user/shared/board.mk
rm -f user/shared/include/ralink_board.h

# Clean kernel build artifacts that would be rebuilt
rm -rf linux-3.4x/arch/mips/ramdisk/*.gz 2>/dev/null || true
rm -f linux-3.4.x/vmlinux 2>/dev/null || true
rm -f linux-3.4.x/linux 2>/dev/null || true

# Restore wifi driver directories
rm -rf linux-3.4.x/drivers/net/wireless/ralink/rt2860v2
rm -rf linux-3.4.x/drivers/net/wireless/ralink/rt3090
rm -rf linux-3.4.x/drivers/net/wireless/ralink/rt5392
rm -rf linux-3.4.x/drivers/net/wireless/ralink/rt5592
rm -rf linux-3.4.x/drivers/net/wireless/ralink/rt3593
rm -rf linux-3.4.x/drivers/net/wireless/ralink/mt7610
rm -rf linux-3.4.x/drivers/net/wireless/ralink/mt76x2
rm -rf linux-3.4.x/drivers/net/wireless/ralink/mt76x3
rm -rf linux-3.4.x/drivers/net/wireless/ralink/mt7628
rm -rf linux-3.4.x/drivers/net/wireless/ralink/mt7615
rm -rf linux-3.4.x/drivers/net/wireless/ralink/mt7915

# Restore PPE
rm -rf linux-3.4.x/net/nat/hw_nat

echo "Clear completed"
exit 0
